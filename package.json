{
  "name": "sightflow",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/tooling.mjs dev",
    "build": "tsc -b && node scripts/tooling.mjs build",
    "typecheck": "tsc -b",
    "test": "node scripts/tooling.mjs test",
    "test:e2e": "playwright test",
    "test:licenses": "npm run build && playwright test --config=playwright.licenses.config.ts",
    "lint": "eslint .",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write src e2e scripts *.ts *.js"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.11",
    "@tailwindcss/vite": "4.3.5",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.5",
    "tonal": "6.4.2",
    "vexflow": "5.0.0",
    "webmidi": "3.1.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "@playwright/test": "1.65.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.0.1",
    "fast-check": "4.1.1",
    "jsdom": "26.1.0",
    "license-checker-rseidelsohn": "4.4.2",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "read-package-json": {
      "glob": "14.0.2"
    },
    "minimatch": "11.0.1"
  }
}
